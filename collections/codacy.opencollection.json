{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codacy API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "apikey": {
        "key": "api-token",
        "value": "{{apiToken}}",
        "in": "header"
      }
    }
  },
  "items": [
    {
      "info": { "name": "Account", "type": "folder" },
      "items": [
        {
          "info": { "name": "Get the authenticated user", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/user" },
          "docs": "Get the authenticated user."
        }
      ]
    },
    {
      "info": { "name": "Organizations", "type": "folder" },
      "items": [
        {
          "info": { "name": "List organizations for a provider", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/user/organizations/{provider}" },
          "docs": "List the account's organizations for a Git provider."
        },
        {
          "info": { "name": "Get a single organization", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/user/organizations/{provider}/{remoteOrganizationName}" },
          "docs": "Get a single organization the account belongs to."
        }
      ]
    },
    {
      "info": { "name": "Repositories", "type": "folder" },
      "items": [
        {
          "info": { "name": "List organization repositories with analysis", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories" },
          "docs": "List an organization's repositories with their analysis state."
        },
        {
          "info": { "name": "Get a repository with analysis", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}" },
          "docs": "Get a repository with its analysis state."
        },
        {
          "info": { "name": "Follow a repository", "type": "http" },
          "http": { "method": "POST", "url": "https://api.codacy.com/api/v3/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/follow" },
          "docs": "Follow a repository already added to Codacy."
        }
      ]
    },
    {
      "info": { "name": "Issues", "type": "folder" },
      "items": [
        {
          "info": { "name": "Search repository issues", "type": "http" },
          "http": { "method": "POST", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/issues/search", "body": { "type": "json", "data": "{}" } },
          "docs": "Search a repository's issues by category and severity."
        },
        {
          "info": { "name": "Get a single issue", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/issues/{issueId}" },
          "docs": "Get a single issue."
        }
      ]
    },
    {
      "info": { "name": "Pull Requests", "type": "folder" },
      "items": [
        {
          "info": { "name": "List repository pull requests", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/pull-requests" },
          "docs": "List a repository's pull requests with analysis."
        },
        {
          "info": { "name": "Get a pull request with analysis", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/pull-requests/{pullRequestNumber}" },
          "docs": "Get a single pull request with analysis."
        },
        {
          "info": { "name": "Trigger AI Reviewer on a pull request", "type": "http" },
          "http": { "method": "POST", "url": "https://api.codacy.com/api/v3/analysis/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/pull-requests/{pullRequestNumber}/ai-reviewer/trigger" },
          "docs": "Trigger the AI Reviewer on a pull request."
        }
      ]
    },
    {
      "info": { "name": "Coverage", "type": "folder" },
      "items": [
        {
          "info": { "name": "Get pull request coverage", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/coverage/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/pull-requests/{pullRequestNumber}" },
          "docs": "Get coverage for a pull request."
        },
        {
          "info": { "name": "Get per-file pull request coverage", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/coverage/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/pull-requests/{pullRequestNumber}/files" },
          "docs": "Get per-file coverage for a pull request."
        }
      ]
    },
    {
      "info": { "name": "Security", "type": "folder" },
      "items": [
        {
          "info": { "name": "Get pull request quality settings", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/settings/quality/pull-requests" },
          "docs": "Get the pull request quality gate settings."
        },
        {
          "info": { "name": "Get repository public SSH key", "type": "http" },
          "http": { "method": "GET", "url": "https://api.codacy.com/api/v3/organizations/{provider}/{remoteOrganizationName}/repositories/{repositoryName}/settings/stored-ssh-key" },
          "docs": "Get the repository's stored public SSH key."
        }
      ]
    }
  ]
}
